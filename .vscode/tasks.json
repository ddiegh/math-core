{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar math-core (Soporte Subcarpetas)",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-I",
                "${workspaceFolder}/cpp_version/include",
                "${file}",
                "-o",
                "${workspaceFolder}/cpp_version/bin/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpp_version"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila subcarpetas, busca cabeceras en include/ y guarda en bin/"
        }
    ],
    "version": "2.0.0"
}